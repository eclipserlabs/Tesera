{
  "name": "tesera",
  "version": "0.2.0",
  "type": "module",
  "description": "Approval-gated, tamper-evident evidence for consequential function calls — Effect/TypeScript sibling of the Python tesera package.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eclipserlabs/tesera"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "verifiers/verify.mjs",
    "README.md"
  ],
  "exports": {
    ".": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "vectors": "vitest run test/vectors.test.ts",
    "prepack": "mkdir -p verifiers && cp ../verifiers/node/verify.mjs verifiers/verify.mjs && cp ../LICENSE LICENSE"
  },
  "dependencies": {
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0"
  }
}
